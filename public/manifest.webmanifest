      ]
    },
    {
      "name": "Stats",
      "short_name": "Stats",
      "url": "./#/stats",
      "icons": [
        { "src": "icons/shortcut-stats-192.png", "sizes": "192x192", "type": "image/png" }
      ]
    }
  ]
