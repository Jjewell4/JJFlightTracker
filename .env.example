# Copy to .env.local for local dev; set the same names in Vercel → Settings → Environment Variables.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional screenshot extraction. SERVER ONLY: never prefix this key with VITE_.
# Configure these in Vercel, run supabase/screenshot-import.sql, then redeploy.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
